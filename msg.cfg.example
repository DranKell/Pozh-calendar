# ==============================================================================
# ПРИМЕР КОНФИГУРАЦИИ СЕРВИСА РАССЫЛОК И УВЕДОМЛЕНИЙ: ПОЧТА И МЕССЕНДЖЕР MAX
# Файл: msg.cfg.example (Скопируйте в msg.cfg для настройки)
# ==============================================================================

[general]
# Общие настройки рассылок
enabled = true
# Префикс перед темой уведомления
subject_prefix = [Календарь ТО]
# Временная зона для формирования времени в уведомлениях
timezone = Europe/Moscow
# Отправлять ли тестовое уведомление при старте сервиса
send_startup_ping = false


# ==============================================================================
# БЛОК 1: НАСТРОЙКИ ПОЧТОВОГО СЕРВЕРА И РАССЫЛКИ (EMAIL / SMTP)
# Все необходимые параметры для отправки писем через любой SMTP-сервер
# ==============================================================================
[email]
# Включить отправку уведомлений на электронную почту (true / false)
enabled = true

# Адрес SMTP-сервера (например: smtp.yandex.ru, smtp.mail.ru, smtp.gmail.com или корпоративный хост)
smtp_host = smtp.yandex.ru

# Порт SMTP:
# 465 - SSL/TLS (рекомендуется для Яндекс/Mail.ru)
# 587 - STARTTLS
# 25  - без шифрования (внутренние корпоративные релеи)
smtp_port = 465

# Использовать прямое SSL/TLS подключение (true для порта 465)
use_ssl = true

# Использовать STARTTLS (true для порта 587)
use_starttls = false

# Требуется ли авторизация на сервере
require_auth = true

# Логин / учетная запись для отправки (обычно полный email)
smtp_user = notifications@yourcompany.ru

# Пароль от почты (для Яндекс/Mail/Google используйте «Пароль для внешних приложений»)
smtp_password = your_app_secret_password_here

# Таймаут соединения в секундах
timeout_seconds = 15

# Имя и email отправителя, которые увидит адресат
from_name = Служба пожарной безопасности и ТО
from_email = notifications@yourcompany.ru

# Email для ответа (Reply-To)
reply_to = support@yourcompany.ru

# Основной список адресатов (email через запятую или точку с запятой)
# Сюда приходят уведомления инспектора о приближающихся работах, просрочках и счетах
to_recipients = chief-engineer@yourcompany.ru, dispatcher@yourcompany.ru

# Копия (Cc) - через запятую
cc_recipients = 

# Скрытая копия (Bcc) - для архива или контроля руководителя
bcc_recipients = director@yourcompany.ru


# ==============================================================================
# БЛОК 2: НАСТРОЙКИ ИНТЕГРАЦИИ С МЕССЕНДЖЕРОМ MAX (MAX BOT API)
# Документация API: https://dev.max.ru/docs-api
# ==============================================================================
[max_messenger]
# Включить отправку уведомлений в мессенджер MAX (true / false)
enabled = true

# Базовый адрес API платформы MAX (актуальный URL: https://platform-api2.max.ru)
api_url = https://platform-api2.max.ru

# Идентификатор бота в платформе MAX (ID бота из кабинета партнера dev.max.ru)
bot_id = id5921029563_bot

# Токен авторизации бота (выдается в бизнес-кабинете / платформе MAX)
# Передается в заголовке запроса Authorization: <bot_token>
bot_token = your_max_bot_token_secret_here

# Имя бота (для логов и отображения)
bot_name = Инспектор ТО Бот

# ID основного группового чата или канала дежурной службы для рассылки алертов
# (числовой chat_id или строковый идентификатор чата в MAX)
default_chat_id = 14180389

# Дополнительные чаты или пользователи для персональных уведомлений (через запятую)
# Например: ID ответственного инженера, ID руководителя объекта
alert_chat_ids = 987654321, 1122334455

# Формат разметки текста сообщений: markdown / html / plain
parse_mode = markdown

# Отправлять ли без звука / тихое уведомление (true / false)
silent_notifications = false

# Проверять валидность сертификатов Минцифры РФ (true рекомендуется)
verify_ssl = true

# Таймаут HTTP-запроса к MAX API в секундах
request_timeout_seconds = 10


# ==============================================================================
# ТРИГГЕРЫ И ПРАВИЛА РАССЫЛОК (НАПОМИНАНИЯ И СОБЫТИЯ)
# Правило интервалов: инспекционные напоминания за 10, 7, 3, 1 дней
# ==============================================================================
[triggers]
# Напоминать о запланированных работах за N дней (10, 7, 3, 1 день до срока выполнения)
remind_days_before = 10, 7, 3, 1

# Время ежедневной утренней рассылки сводки (ЧЧ:ММ)
daily_digest_time = 08:30

# Отправлять моментальное уведомление при появлении просрочки (true / false)
notify_on_overdue = true

# Отправлять уведомление при создании нового счёта (true / false)
notify_on_invoice_created = true

# Отправлять уведомление при поступлении оплаты по счёту (true / false)
notify_on_invoice_paid = true

# Отправлять уведомление при отмене или переносе выполнения (true / false)
notify_on_execution_rescheduled = true


# ==============================================================================
# НАСТРОЙКИ ИИ-ПОМОЩНИКА (НЕЙРОСЕТИ И РЕГЛАМЕНТЫ 123-ФЗ)
# Схема работы: "ИЛИ-ИЛИ" (YandexGPT или GigaChat)
# 1. Если один недоступен / не указан токен / ошибка сети -> мгновенно переключается на другой!
# 2. Если недоступны оба -> включается встроенная локальная база 123-ФЗ/СП/ППР.
# DeepSeek исключён!
# ==============================================================================
[ai_assistant]
# Включить ИИ-помощника для рекомендаций регламентов, распознавания и инспекционных алертов (true / false)
enabled = true

# Цепочка автоматического переключения (Auto-Failover): только yandexgpt и gigachat!
providers = yandexgpt, gigachat

# Температура генерации (0.1 - 0.3 рекомендуется для строгих нормативов пожарной безопасности)
temperature = 0.2

# Таймаут запроса в секундах
request_timeout_seconds = 20

# Всегда переключаться на встроенную экспертную базу 123-ФЗ при сетевых ошибках
fallback_to_rules = true

# Системная инструкция для ИИ
system_prompt = Ты — ведущий государственный инспектор по пожарному надзору и эксперт по системам противопожарной защиты объектов РФ (123-ФЗ, ППР № 1479, СП 484.1311500, СП 486.1311500). Твой стиль — строгий, профессиональный, предельно лаконичный, без лишней воды и шаблонов, с акцентом на безопасность, наличие записей в журнале эксплуатации и ответственность руководства.


# ------------------------------------------------------------------------------
# 1. YANDEX CLOUD / YANDEXGPT (Сервисный аккаунт / API-ключ)
# ------------------------------------------------------------------------------
[ai_yandexgpt]
api_url = https://llm.api.cloud.yandex.net/foundationModels/v1/completion
api_key = your_yandex_cloud_api_key_here
folder_id = your_yandex_folder_id_here
model = yandexgpt/latest


# ------------------------------------------------------------------------------
# 2. СБЕР GIGACHAT (Авторизация через OAuth + Client Secret)
# ------------------------------------------------------------------------------
[ai_gigachat]
api_url = https://gigachat.devices.sberbank.ru/api/v1
api_key = your_gigachat_api_key_here
model = GigaChat
scope = GIGACHAT_API_PERS
